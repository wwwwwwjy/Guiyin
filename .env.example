# 至少 12 位；部署前填写。
BRIDGE_ADMIN_PASSWORD=
HUB_PORT=8600
# latest 跟踪发布；如需固定版本，可填写 0.9.23。
GUIYIN_IMAGE_TAG=latest
# 飞牛 NAS 上已有的音乐文件夹；在融合歌单中选择此挂载目录下的保存文件夹。
NAS_MUSIC_DIR=/vol1/1000/Music
HUB_DATA_DIR=./data
FNMUSIC_SOCKET_PATH=/run/trim_music.socket
FNMUSIC_FNDB_DIR=/usr/local/apps/@appdata/trim.music/db
PIP_INDEX_URL=https://pypi.org/simple
# 如默认镜像加速源异常，可指定可访问的官方 Python 镜像来源。
PYTHON_IMAGE=python:3.12-slim
